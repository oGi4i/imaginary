# syntax=docker.io/docker/dockerfile:1.9.0@sha256:dc9e236567481e0aca4c1f52351af213b9a176622f10e3f4a86e5cc48919fa01
# This recipe requires the verified context generated by tooling/runtime-image/build.py.
FROM debian@sha256:1a43c9ee12ad03a221ffa57e9c41a73388b6cf4cb84c50c3ed734e9ce8ca3c6a AS build-base
ARG SOURCE_DATE_EPOCH
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
COPY inputs/build/mirror /mirror
COPY inputs/build/install.sh /install.sh
RUN --network=none /bin/sh /install.sh && rm -rf /mirror /install.sh /var/lib/apt/lists/*

FROM build-base AS builder
COPY inputs/go.tar.gz /tmp/go.tar.gz
COPY inputs/vips.tar.gz /tmp/vips.tar.gz
RUN --network=none tar -C /usr/local -xzf /tmp/go.tar.gz && \
    tar -C /tmp -xzf /tmp/vips.tar.gz && \
    cd /tmp/vips-8.10.0 && \
    CFLAGS='-g -O3' CXXFLAGS='-D_GLIBCXX_USE_CXX11_ABI=0 -g -O3' \
    ./configure --disable-debug --disable-dependency-tracking --disable-introspection \
      --disable-static --enable-gtk-doc-html=no --enable-gtk-doc=no --enable-pyvips8=no && \
    make -j2 && make install && ldconfig && rm -rf /tmp/vips-8.10.0 /tmp/*.tar.gz
ENV PATH=/usr/local/go/bin:${PATH} CGO_ENABLED=1 GO111MODULE=on GOWORK=off GOPROXY=off GOSUMDB=off GOFLAGS=-mod=readonly GOMODCACHE=/go/pkg/mod
WORKDIR /src
COPY inputs/modules /go/pkg/mod
COPY source/ /src/
COPY inputs/bimg-patch/ /bimg-patch/

FROM builder AS verification
RUN --network=none go mod verify && \
    cd /bimg-patch && sha256sum -c manifest.sha256 && \
    cd /go/pkg/mod/github.com/h2non/bimg@v1.1.4 && test ! -e go.mod && find . -type f | LC_ALL=C sort > /tmp/bimg-original-files && \
    cd /bimg-patch/module && printf 'module github.com/h2non/bimg\n' | cmp - go.mod && \
    find . -type f ! -path ./go.mod | LC_ALL=C sort > /tmp/bimg-staged-files && \
    cmp /tmp/bimg-original-files /tmp/bimg-staged-files && \
    while IFS= read -r file; do if [ "$file" != ./resizer.go ]; then cmp "$file" "/go/pkg/mod/github.com/h2non/bimg@v1.1.4/$file" || exit 1; fi; done < /tmp/bimg-original-files && \
    cd /src && \
    timeout --signal=KILL 300 go test -modfile=/bimg-patch/patch.mod -timeout=240s ./... && \
    timeout --signal=KILL 300 go test -modfile=/bimg-patch/patch.mod -race -timeout=240s ./... && \
    timeout --signal=KILL 120 go vet -modfile=/bimg-patch/patch.mod ./... && \
    timeout --signal=KILL 120 go build -modfile=/bimg-patch/patch.mod -trimpath -o /imaginary -ldflags='-s -w -h -X main.Version=dev' . && \
    cmp go.sum /bimg-patch/patch.sum && \
    mkdir -p /imaginary-build && \
    cp /bimg-patch/identity.json /imaginary-build/bimg-patch-identity.json && \
    cp /bimg-patch/manifest.sha256 /imaginary-build/bimg-patch-manifest.sha256 && \
    { vips --version; vips --vips-config; vips -l foreign; } > /imaginary-build/builder-vips.txt && \
    sha256sum /imaginary | awk '{print $1 "  imaginary"}' > /imaginary-build/artifact-sha256.txt && \
    find /usr/local/lib -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum >> /imaginary-build/artifact-sha256.txt && \
    find /usr/local/lib -type l -printf '%p -> %l\n' | LC_ALL=C sort > /imaginary-build/artifact-symlinks.txt && \
    chmod 0444 /imaginary-build/*.txt

FROM debian@sha256:1a43c9ee12ad03a221ffa57e9c41a73388b6cf4cb84c50c3ed734e9ce8ca3c6a AS runtime
ARG SOURCE_DATE_EPOCH
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
COPY inputs/runtime/mirror /mirror
COPY inputs/runtime/install.sh /install.sh
RUN --network=none /bin/sh /install.sh && rm -rf /mirror /install.sh /var/lib/apt/lists/*
COPY --from=verification /usr/local/lib/ /usr/local/lib/
COPY --from=verification /imaginary /usr/local/bin/imaginary
COPY --from=verification /imaginary-build/ /usr/local/share/imaginary-build/
RUN --network=none ldconfig
ENV PORT=9000
USER nobody
ENTRYPOINT ["/usr/local/bin/imaginary"]
EXPOSE 9000
